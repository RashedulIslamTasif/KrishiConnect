                {f.isVerified && <span style={{ background:'rgba(29,158,117,.08)', color:'#1d9e75', fontSize:11, fontWeight:600, padding:'4px 10px', borderRadius:99 }}>✓ Verified</span>}
              </div>
            </Link>
          ))}
        </div>
      )}
    </div>
