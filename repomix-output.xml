                  {selected.avatar ? <img src={selected.avatar} alt="" style={{ width:'100%', height:'100%', objectFit:'cover' }} /> : selected.name?.[0]?.toUpperCase()}
                </div>
                <div>
                  <div style={{ display:'flex', alignItems:'center', gap:6 }}>
