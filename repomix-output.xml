        <div style={{ textAlign:'center', marginTop:24, fontSize:14, color:'#7a9070' }}>
          Already have an account? <Link to="/login" style={{ color:'#4e9e2a', textDecoration:'none', fontWeight:700 }}>Sign In →</Link>
        </div>
      </div>
    </div>
  );
}
